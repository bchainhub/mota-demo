{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"paths": {
			"$lib": [
				"./src/lib"
			],
			"$lib/*": [
				"./src/lib/*"
			],
			"$components": [
				"./src/lib/components"
			],
			"$components/*": [
				"./src/lib/components/*"
			],
			"$modules": [
				"./src/lib/modules"
			],
			"$modules/*": [
				"./src/lib/modules/*"
			],
			"$data": [
				"./src/data"
			],
			"$data/*": [
				"./src/data/*"
			]
		}
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
